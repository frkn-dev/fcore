[Unit]
Description=FRKN Marketing Service
After=network.target
Wants=network.target

[Service]
Type=simple
User=fcore
Group=fcore
ExecStart=/usr/local/bin/mrkting /etc/fcore/mrkting/config.toml
Restart=on-failure
RestartSec=5
WorkingDirectory=/var/lib/fcore/mrkting

# Security hardening
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/fcore/mrkting
ReadWritePaths=/var/log/fcore/mrkting

[Install]
WantedBy=multi-user.target
