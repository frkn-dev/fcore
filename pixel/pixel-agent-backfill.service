[Unit]
Description=FRKN Pixel Analytics Backfill
After=network.target
Wants=network.target

[Service]
Type=oneshot
User=pixel-agent
Group=pixel-agent
ExecStart=/usr/local/bin/pixel-agent-backfill /etc/pixel-agent/backfill.toml
WorkingDirectory=/var/lib/pixel-agent

# Security hardening
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/pixel-agent
ReadWritePaths=/var/log/nginx
